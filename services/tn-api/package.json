{
  "name": "@talent-nexus/tn-api",
  "version": "0.1.0",
  "private": true,
  "description": "Talent Nexus Phase 3 independent backend foundation",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx --env-file=.env watch src/server.ts",
    "start": "node --env-file=.env dist/server.js",
    "test": "tsx --test tests/**/*.test.ts",
    "migrate": "node --env-file=.env dist/migrate.js",
    "pinpin:dry-run": "node --env-file=.env dist/pinpin/dry-run.js",
    "pinpin:verify-synthetic": "node --env-file=.env dist/pinpin/verify-synthetic.js",
    "pinpin:import-deleted-synthetic": "node --env-file=.env dist/pinpin/import-deleted-synthetic.js",
    "pinpin:import-active-synthetic": "node --env-file=.env dist/pinpin/import-active-synthetic.js",
    "pinpin:import-real-pilot": "node --env-file=.env dist/pinpin/import-real-pilot.js",
    "pinpin:verify-real-pilot": "node --env-file=.env dist/pinpin/verify-real-pilot.js",
    "pinpin:api-pilot-smoke": "node --env-file=.env dist/pinpin/api-pilot-smoke.js",
    "pinpin:probe-real-pilot-noop": "node --env-file=.env dist/pinpin/probe-real-pilot-noop.js",
    "pinpin:import-full": "node --env-file=.env dist/pinpin/import-full.js",
    "pinpin:sync:manual": "node dist/pinpin/manual-sync.js",
    "ai:check": "node dist/ai/ai-check.js",
    "enrichment:verify-synthetic": "node dist/services/enrichment-controlled-verify.js",
    "plugin-sidecar:verify-synthetic": "node dist/services/plugin-sidecar-controlled-verify.js",
    "candidate-intake:verify-43198": "node dist/services/candidate-intake-production-verify.js 43198",
    "processing:worker": "node dist/processing-worker.js",
    "processing:backfill-dry-run": "node dist/services/historical-backfill-dry-run.js",
    "pinpin:full-preflight": "node --env-file=.env dist/pinpin/full-preflight.js",
    "pinpin:incremental-dry-run": "node --env-file=.env dist/pinpin/incremental-dry-run.js",
    "pinpin:sync:incremental": "node dist/pinpin/incremental-sync.js"
  },
  "dependencies": {
    "@google/genai": "2.16.0",
    "fastify": "^5.6.0",
    "jose": "^6.2.3",
    "msnodesqlv8": "5.2.3",
    "pg": "^8.16.3",
    "uuid": "^11.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.4",
    "pg-mem": "^3.0.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
