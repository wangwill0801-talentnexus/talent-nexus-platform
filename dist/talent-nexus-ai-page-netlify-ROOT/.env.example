# Environment variables — COPY to `.env` (Netlify: Site settings → Environment).
# NO real secrets are committed; .env is git-ignored.

# --- Gemini (server-side only; never shipped to browser/extension) ---
# Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000

# --- Backend mode ---
# true  -> return anonymized mock JSON, no network/key needed (offline dev & tests)
# false -> call Gemini with GEMINI_API_KEY
AI_MOCK_MODE=false

# --- CORS ---
# Comma-separated exact origins allowed to call the functions. Empty + TEST
# open CORS (reflects caller origin) ONLY for local/prototype. In production
# set exact origins AND change lib/cors.mjs TEST_OPEN_CORS=false.
ALLOWED_ORIGINS=

# --- Auth (see docs/AI_SECURITY.md) ---
# test      -> TEST ONLY (default; Bearer token required if a real key is set)
# interface -> INTERFACE ONLY (accepts any token, logs presence)
AI_AUTH_MODE=test
# TEST-ONLY shared secret. When GEMINI_API_KEY is set, resume-ai-parse requires
# "Authorization: Bearer <AI_TEST_TOKEN>". Prevents an open Gemini proxy.
# NOT production auth (M365/TNT is a Codex task). Keep this out of source control.
AI_TEST_TOKEN=
